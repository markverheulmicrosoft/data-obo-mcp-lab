# Kopieer naar .env. Geen waarden of secrets committen.
# Drie appregistraties, in dezelfde testtenant; zie docs\bouwen.md.
ENTRA_TENANT_ID=
GATEWAY_CLIENT_ID=
GATEWAY_CREDENTIAL_MODE=secret
GATEWAY_CLIENT_SECRET=
RIGHTS_CLIENT_ID=
CLIENT_APP_ID=

# Alleen lokaal gebruikt de gateway bovenstaande secret.
# Bicep kiest in Azure expliciet managed-identity en configureert de MI-client-ID.

# De servers luisteren lokaal op 8000 en 8001.
# HOST/PORT kunnen per proces worden ingesteld voor containerhosting.
# Zet PORT niet in deze gedeelde .env wanneer beide servers lokaal draaien.
GATEWAY_URL=http://127.0.0.1:8000/mcp
RIGHTS_URL=http://127.0.0.1:8001/mcp
